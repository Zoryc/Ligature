# Copy to docker/.env (docker compose reads .env from the compose file's directory) and edit.

# Public URL of the instance, as users type it in the browser (scheme + host [+ port]). Required.
LIGATURE_ORIGIN=https://latex.example.org

# TeX Live base image of the compiler. Default: the full scheme (4-5 GB). For a small VPS use a
# medium-scheme tag (1-2 GB). Verify the tag on Docker Hub (texlive/texlive) and ideally pin a digest.
# LIGATURE_TEXLIVE_IMAGE=texlive/texlive:TL2026-full
