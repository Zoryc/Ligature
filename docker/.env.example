# Copy to docker/.env (docker compose reads .env from the compose file's directory) and edit.

# Public URL of the instance, exactly as users type it in the browser. Required.
# Form: scheme + host [+ port], no trailing slash, no path: https://latex.example.org or
# https://example.org:8443, not https://latex.example.org/ or https://example.org/latex.
LIGATURE_ORIGIN=https://latex.example.org

# Host port on 127.0.0.1 the reverse proxy talks to (default 3000). If you change it, change the
# reverse_proxy line of your Caddyfile to the same port.
# LIGATURE_PORT=3000

# Behind Caddy (it overwrites X-Forwarded-For), so login rate limits apply per client IP instead of to
# the proxy's address. Set 0 only if the app port is reachable by anything but your reverse proxy.
LIGATURE_TRUST_PROXY=1

# Days a deleted file stays in the project's trash can before it is purged automatically (default 30).
# LIGATURE_TRASH_RETENTION_DAYS=30

# TeX Live base image of the compiler. Default (in compose.yaml and Dockerfile.compiler): the full scheme,
# texlive/texlive:latest-full pinned by digest (about 2.8 GB compressed). For a small VPS use the medium
# scheme (about 0.9 GB compressed):
# LIGATURE_TEXLIVE_IMAGE=texlive/texlive:latest-medium@sha256:3a3949a847929f989eb70a4c92ba43b38dcd4242e08a8a6a0b6f5ef3db1525ee

# Extra CTAN packages installed into the compiler image at build time (space-separated tlmgr names), for
# example on top of the medium scheme. The compiler has no network, so rebuild after changing this:
#   docker compose -f docker/compose.yaml up -d --build
# LIGATURE_TEXLIVE_EXTRA=biblatex biber tikz-cd
