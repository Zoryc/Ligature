# syntax=docker/dockerfile:1
#
# Ligature compiler: TeX Live 2026 (Island of TeX image) + the small Node worker (apps/compiler).
# Build from the repository root:   docker build -f docker/Dockerfile.compiler -t ligature-compiler .
#
# The worker has NO npm runtime dependencies: only its TypeScript sources are copied, and Node runs
# them directly (type stripping, Node >= 24).

# --- TeX Live base image -------------------------------------------------------------------------
# Island of TeX images (texlive/texlive on Docker Hub, built from registry.gitlab.com/islandoftex/images/texlive,
# Debian testing based). Tags verified on Docker Hub on 2026-11-18:
#   - there are NO "TL2026-*" tags: the current release (TeX Live 2026) is published as "latest-<scheme>"
#     and rebuilt weekly; a year only gets "TL<year>-historic" tags once the next release is out;
#   - "latest" = "latest-full" (full scheme, no docs/sources, about 2.8 GB compressed);
#   - "latest-medium" (medium scheme, about 0.9 GB compressed) is the small-VPS / CI variant.
# The tags move, so the default is pinned by digest (multi-arch index; amd64 and arm64) for reproducible builds.
# To update: docker buildx imagetools inspect texlive/texlive:latest-full   (take the index digest).
# Medium variant (the PLAN's "compiler:tl2026-medium"):
#   docker build -f docker/Dockerfile.compiler \
#     --build-arg TEXLIVE_IMAGE=texlive/texlive:latest-medium@sha256:3a3949a847929f989eb70a4c92ba43b38dcd4242e08a8a6a0b6f5ef3db1525ee \
#     -t ligature-compiler:tl2026-medium .
# or set LIGATURE_TEXLIVE_IMAGE when using docker/compose.yaml (see docker/.env.example).
ARG TEXLIVE_IMAGE=texlive/texlive:latest-full@sha256:c21636aa13e86716d15dab4e352356cb0d34f9365d6091db066e5df71041d67b
ARG NODE_IMAGE=node:24-bookworm-slim

FROM ${NODE_IMAGE} AS node

FROM ${TEXLIVE_IMAGE}
# Lets `docker image prune --filter label=io.ligature.image` remove only Ligature's old images (docker/README.md).
LABEL io.ligature.image=compiler

# Node 24: just the binary from the official image (the TeX Live image is Debian-based, newer glibc).
COPY --from=node /usr/local/bin/node /usr/local/bin/node

# prlimit (util-linux) applies the per-compile resource limits; usually already present.
# tini runs as PID 1 and reaps orphans: when a timed-out latexmk's process group is killed, its sh/pdflatex
# children are re-parented to PID 1. Node only waits for the pids it spawned itself, so with node as PID 1
# those zombies would pile up until they exhaust pids_limit / the project uid's process limit.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends tini; \
    if ! command -v prlimit >/dev/null 2>&1; then apt-get install -y --no-install-recommends util-linux; fi; \
    rm -rf /var/lib/apt/lists/*; \
    node --version; latexmk -v | head -n 2; prlimit --version; tini --version

# TeX hardening, appended to the installation's top-level texmf.cnf (which overrides texmf-dist/web2c/texmf.cnf).
# The worker also sets the same values as environment variables for every run (belt and braces).
COPY docker/texmf.cnf /tmp/ligature-texmf.cnf
RUN set -eux; \
    TL_ROOT="$(kpsewhich -var-value=SELFAUTOPARENT)"; \
    cat /tmp/ligature-texmf.cnf >> "$TL_ROOT/texmf.cnf"; \
    rm /tmp/ligature-texmf.cnf; \
    test "$(kpsewhich -var-value=shell_escape)" = "f"; \
    test "$(kpsewhich -var-value=openin_any)" = "p"; \
    test "$(kpsewhich -var-value=openout_any)" = "p"

# Extra TeX Live packages: space-separated tlmgr package names, installed now because the compiler has no network
# at run time. Mostly useful with the medium scheme (the full scheme has everything), e.g.
#   docker build -f docker/Dockerfile.compiler --build-arg TEXLIVE_EXTRA_PACKAGES="tcolorbox fontawesome5" ...
# This needs the network at build time and a TeX Live repository of the image's TeX Live year (tlmgr refuses a
# newer one). Before the formats and font caches below, so that those include the new packages.
ARG TEXLIVE_EXTRA_PACKAGES=""
RUN set -eu; \
    pkgs="$TEXLIVE_EXTRA_PACKAGES"; \
    if [ -z "$(printf '%s' "$pkgs" | tr -d '[:space:]')" ]; then exit 0; fi; \
    for p in $pkgs; do \
      case "$p" in -*|*[!A-Za-z0-9._+-]*) echo "TEXLIVE_EXTRA_PACKAGES: not a package name: '$p'" >&2; exit 1;; esac; \
    done; \
    set -x; \
    tlmgr update --self; \
    tlmgr install $pkgs

# Pre-generate formats and the LuaTeX font cache at build time: the root filesystem is read-only at runtime,
# and without these the first LuaLaTeX/fontspec compile is very slow or fails. Caches go to TEXMFSYSVAR,
# which every project uid can read; per-project additions go to the project's own TEXMFVAR. luaotfload only
# reads its font-names database from the first WRITABLE cache dir, i.e. the project's own: the helper copies
# this one there before a project's first LuaLaTeX compile (apps/compiler/src/fontNames.ts).
RUN set -eux; \
    fmtutil-sys --all > /tmp/fmtutil.log 2>&1 || (tail -n 50 /tmp/fmtutil.log; exit 1); \
    TEXMFVAR="$(kpsewhich -var-value=TEXMFSYSVAR)" luaotfload-tool --update --force; \
    mktexlsr; \
    rm -f /tmp/fmtutil.log; \
    chmod -R a+rX "$(kpsewhich -var-value=TEXMFSYSVAR)"

# The worker. Root-owned and world-readable: the per-compile helper runs as the project's uid and must be
# able to read (never write) these files.
WORKDIR /app
COPY apps/compiler/package.json apps/compiler/package.json
COPY apps/compiler/src apps/compiler/src
RUN chown -R root:root /app && chmod -R a+rX,go-w /app \
    && mkdir -p /builds /run/ligature && chmod 0711 /builds && chmod 0700 /run/ligature

ENV NODE_ENV=production \
    SANDBOX=uid \
    COMPILER_LISTEN=unix:/run/ligature/compiler.sock \
    BUILDS_DIR=/builds

# Runs as root on purpose: it needs SETUID/SETGID to drop to each project's uid and CHOWN to hand over
# build directories. Compose drops every other capability (see docker/compose.yaml).
USER root

# Probes whatever COMPILER_LISTEN names (the same variable the worker listens on).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "/app/apps/compiler/src/healthcheck.ts"]

# tini is PID 1 (see above); it forwards SIGTERM to the worker. With `docker run --init` / compose `init: true`
# this still works (tini then only warns that it is not PID 1), but neither is needed.
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/app/apps/compiler/src/worker.ts"]
CMD []
