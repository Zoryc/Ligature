% Ligature compiler hardening. Appended to $SELFAUTOPARENT/texmf.cnf (the TeX Live installation's
% local override file) by docker/Dockerfile.compiler. The worker sets the same values as environment
% variables for every run as well. These are a FIRST layer only: LuaTeX's Lua `io` library is not
% reliably restricted by openin_any, so the OS sandbox (one uid per project, no network) is the real boundary.

% No \write18 at all. Restricted mode (p, for minted) is an explicit per-instance admin opt-in only.
shell_escape = f

% Paranoid: no dot files, no parent directories, no absolute paths (outside TEXMFOUTPUT).
% NOTE: since TeX Live 2026, kpathsea applies this to WRITING only; openin_any is ignored for reading
% (tex-file.c: reading is always allowed). Kept for older TeX Live years. Reading is bounded only by the
% uid sandbox: a document can read world-readable files of this image (see apps/compiler/test/corpus/README.md).
openin_any = p
openout_any = p

% No per-user tree: packages come from TeX Live only (the worker also points TEXMFHOME at /nonexistent).
TEXMFHOME = /nonexistent

% Unwrapped log lines (default 79), so file:line errors and file names can be parsed.
max_print_line = 10000
error_line = 254
half_error_line = 238
