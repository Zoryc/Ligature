# docker compose environment for the CI "docker" job (.github/workflows/ci.yml).
LIGATURE_ORIGIN=http://localhost:3000
LIGATURE_PORT=3000
# The medium scheme keeps CI fast (about 0.9 GB instead of 2.8 GB compressed). Verified on Docker Hub
# 2026-11-18; the docker job checks that the pinned image still resolves before building.
LIGATURE_TEXLIVE_IMAGE=texlive/texlive:latest-medium@sha256:3a3949a847929f989eb70a4c92ba43b38dcd4242e08a8a6a0b6f5ef3db1525ee
